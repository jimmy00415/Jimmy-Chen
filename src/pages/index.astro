---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Base from '../layouts/Base.astro';
import InstitutionRow from '../components/InstitutionRow.astro';
import { identity, recognition } from '../data/profile';
import { career, education } from '../data/institutions';
import { cases } from '../data/cases';
import { localUrl } from '../lib/urls';
import '../styles/personal.css';
---

<Base>
  <div class="personal-home">
    <section class="personal-intro personal-wrap" aria-labelledby="name">
      <p class="name-native">CHEN Yiwei</p>
      <h1 id="name">
        Jimmy <span>Chen</span>
      </h1>
      <p class="personal-role">
        <span>AI Engineer</span> · <span>Startup Founder</span> ·{' '}
        <span>Agent Systems Researcher</span>
      </p>
      <p class="personal-current">
        Founder & CEO at <a href="https://simplify-net.com/">Simplify</a>
      </p>
      <p class="personal-statement">
        I build AI systems—and the products around them.
      </p>
      <div class="personal-actions">
        <a class="personal-button" href="#work">
          View selected work
        </a>
        <a href={identity.github}>GitHub</a>
        <a href="#contact">Contact</a>
      </div>
    </section>

    <section
      id="about"
      class="personal-section personal-wrap"
      aria-labelledby="biography-title"
    >
      <h2 id="biography-title">Biography</h2>
      <div class="biography-layout">
        <div class="biography-copy">
          <p>
            I’m Jimmy Chen, an AI engineer, startup founder, and independent
            agent-systems researcher. I’m interested in how AI systems can
            become more reliable, more grounded in evidence, and more useful in
            everyday life.
          </p>
          <p>
            I lead <a href="https://simplify-net.com/">Simplify</a> as Founder &
            CEO, working with our team on product direction, technology, and
            execution. We build <a href="https://matchacode.net/">MatchaCode</a>{' '}
            for AI-assisted coding and{' '}
            <a href="https://flashlaunch.net/">Flash Launch</a> for publishing
            software.
          </p>
          <p>
            Alongside that, I contribute to open source—including a{' '}
            <a href="https://github.com/openclaw/openclaw/pull/148106">
              merged OpenClaw compatibility repair
            </a>
            —and investigate episode retrieval and multimodal evidence for{' '}
            <a href={localUrl('research/personal-ai-memory/')}>
              personal AI memory
            </a>
            .
          </p>
          <p>
            My engineering experience spans grounded retrieval at{' '}
            <a href="https://www.motionexp.com/">Motion Expert</a>, ESG data
            systems at <a href="https://www.climind.co/">Climind</a>, and
            research at{' '}
            <a href="https://www.math.hkbu.edu.hk/">
              Hong Kong Baptist University
            </a>
            .
          </p>
        </div>
        <aside
          class="personal-profile"
          aria-label="Portrait and current interests"
        >
          <Image
            src={portrait}
            alt="Jimmy Chen outdoors by a stone archway"
            widths={[240, 360, 480]}
            sizes="(max-width: 640px) 200px, 240px"
            width={480}
            height={640}
            format="webp"
            loading="eager"
            class="profile-photo"
          />
          <div class="profile-facts">
            <h3>Current interests</h3>
            <p>
              Agent reliability
              <br />
              Grounded retrieval
              <br />
              Long-term multimodal memory
            </p>
            <h3>Also exploring</h3>
            <p>
              Developer tools & AI products
              <br />
              Quantitative research with LightGBM / GRU
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section
      id="journey"
      class="personal-section personal-wrap"
      aria-labelledby="experience-title"
    >
      <h2 id="experience-title">Experience</h2>
      <div class="career-timeline">
        {career.map((institution) => (
          <InstitutionRow institution={institution} />
        ))}
      </div>
    </section>
    <section
      id="education"
      class="personal-section personal-wrap"
      aria-labelledby="education-title"
    >
      <h2 id="education-title">Education</h2>
      <div class="education-list">
        {education.map((institution) => (
          <InstitutionRow institution={institution} />
        ))}
      </div>
    </section>

    <section
      id="research"
      class="personal-section personal-wrap"
      aria-labelledby="research-title"
    >
      <h2 id="research-title">Research interests</h2>
      <p class="research-introduction">
        I’m investigating how a personal AI should retrieve and inspect
        long-term multimodal history to make better predictions about what
        someone will do next.
      </p>
      <div class="research-questions">
        <article>
          <h3>Episode retrieval</h3>
          <p>
            How do we find the relevant moment in a large personal history,
            rather than simply give a model more context?
          </p>
        </article>
        <article>
          <h3>Evidence inspection</h3>
          <p>
            What changes when the model can inspect original text and visual
            evidence instead of relying only on a compressed account?
          </p>
        </article>
      </div>
      <p class="research-progress">
        I built the data and evaluation foundation; comparative evaluation is
        ongoing. The recorded data layer covers 1.4M events, with NextAct
        prediction points using the external NextMe-800 and EgoLife resources.
      </p>
      <a
        class="personal-text-link"
        href={localUrl('research/personal-ai-memory/')}
      >
        Research direction, implementation & limitations →
      </a>
    </section>

    <section
      id="work"
      class="personal-section personal-wrap"
      aria-labelledby="contributions-title"
    >
      <h2 id="contributions-title">Selected work & contributions</h2>
      <div class="personal-work-list">
        {cases.map((work) => (
          <article class="personal-work-entry" data-work={work.slug}>
            <div class="project-heading">
              <h3>
                <a href={localUrl(`${work.category}/${work.slug}/`)}>
                  {work.title}
                </a>
              </h3>
              <span class="project-status">
                {work.slug === 'openclaw'
                  ? 'Merged contribution'
                  : work.slug === 'simplify'
                    ? 'Founder & CEO'
                    : work.slug === 'movie-intelligence'
                      ? 'Public technical demo'
                      : 'Ongoing research'}
              </span>
            </div>
            <p>{work.summary}</p>
            <p class="project-role">{work.role}</p>
            <div class="project-links">
              <a href={localUrl(`${work.category}/${work.slug}/`)}>Read more</a>
              {work.slug === 'openclaw' && (
                <a href="https://github.com/openclaw/openclaw/pull/148106">
                  Pull request ↗
                </a>
              )}
              {work.slug === 'simplify' && (
                <a href="https://simplify-net.com/">Company ↗</a>
              )}
              {work.slug === 'movie-intelligence' && (
                <a href="https://github.com/jimmy00415/HK_Movie_RAG_Chatbot">
                  Code ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="other-projects">
        <h3>Other applied projects</h3>
        <p>
          <strong>Heung Gong Buddy.</strong> As Founder & AI Product Lead, I led
          an AI-assisted Cantonese learning project through{' '}
          <a href="https://www.hkbu.edu.hk/">HKBU</a>’s Common Good in Action
          programme (Oct 2025–Jun 2026), connecting speech recognition,
          contextual learner feedback, and speech synthesis.
        </p>
        <p>
          <a href="https://jimmy00415.github.io/Personal_AI_Demo/">
            <strong>CareMate HK.</strong>
          </a>{' '}
          A frontend-led personal AI prototype exploring continuity, consent,
          and user-controlled records. Interactions are simulated or local to
          the device; it is not a live clinical service.{' '}
          <a href="https://github.com/jimmy00415/Personal_AI_Demo">
            Source code ↗
          </a>
        </p>
      </div>
    </section>

    <section
      class="personal-section personal-wrap recognition-section"
      aria-labelledby="recognition-title"
    >
      <h2 id="recognition-title">Selected recognition</h2>
      <ul>
        {recognition.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    <section
      id="contact"
      class="personal-section personal-wrap contact-section"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title">Contact</h2>
      <p>
        I’m happy to connect about AI engineering, building products, and
        research on agents and personal AI.
      </p>
      <div class="contact-actions">
        <a class="email-link" href={`mailto:${identity.email}`}>
          {identity.email}
        </a>
        <a href={identity.github}>GitHub ↗</a>
      </div>
    </section>
  </div>
</Base>
