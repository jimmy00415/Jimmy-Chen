---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import WorkVisual from '../components/WorkVisual.astro';
import { identity, applied, experience, recognition } from '../data/profile';
import { cases } from '../data/cases';
import { localUrl } from '../lib/urls';
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-identity">
        AI Engineer · Startup Founder
        <br class="mobile-break" /> · Agent Systems Researcher
      </p>
      <h1 id="hero-title">
        I build AI systems<span class="blue">—</span>
        <br />
        and the products
        <br class="desktop-break" /> around them<span class="blue">.</span>
      </h1>
      <p class="hero-description">{identity.description}</p>
      <div class="hero-actions">
        <a class="button" href="#work">
          View selected work <Arrow />
        </a>
        <a class="text-link" href={identity.github}>
          GitHub <Arrow diagonal />
        </a>
      </div>
    </div>
    <aside class="hero-index" aria-label="My areas of focus">
      <div class="index-heading mono">
        A SYSTEMS-TO-PRODUCT PRACTICE <span>↘</span>
      </div>
      <div class="focus-row">
        <span class="focus-number">01</span>
        <div>
          <h2>Make it reliable.</h2>
          <p>Agent runtimes & grounded retrieval</p>
        </div>
        <span class="focus-symbol" aria-hidden="true">
          ⌘
        </span>
      </div>
      <div class="focus-row">
        <span class="focus-number">02</span>
        <div>
          <h2>Make it useful.</h2>
          <p>Product decisions & shipping software</p>
        </div>
        <span class="focus-symbol" aria-hidden="true">
          ↗
        </span>
      </div>
      <div class="focus-row">
        <span class="focus-number">03</span>
        <div>
          <h2>Ask what’s next.</h2>
          <p>Personal AI & long-term memory</p>
        </div>
        <span class="focus-symbol" aria-hidden="true">
          ∴
        </span>
      </div>
      <div class="index-foot mono">
        <span class="status-dot"></span> ENGINEERING ↔ PRODUCT ↔ RESEARCH
      </div>
    </aside>
  </section>

  <section class="evidence-strip wrap" aria-label="Evidence at a glance">
    <a href={localUrl('work/openclaw/')}>
      <span class="eyebrow">Open source</span>
      <strong>Merged OpenClaw contribution</strong>
      <span class="evidence-note">
        Agent-runtime compatibility <Arrow diagonal />
      </span>
    </a>
    <a href={localUrl('work/simplify/')}>
      <span class="eyebrow">Entrepreneurship</span>
      <strong>Founder, Simplify</strong>
      <span class="evidence-note">
        Tools for building & shipping <Arrow diagonal />
      </span>
    </a>
    <a href={localUrl('research/personal-ai-memory/#evidence')}>
      <span class="eyebrow">Research infrastructure</span>
      <strong>1.4M-event data layer</strong>
      <span class="evidence-note">
        Recorded research milestone <Arrow diagonal />
      </span>
    </a>
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Selected work</p>
        <h2 id="work-title">
          From the runtime
          <br />
          to the real world.
        </h2>
      </div>
      <p>
        Four cases in engineering, product building,
        <br class="desktop-break" /> and the questions I’m working on next.
      </p>
    </div>
    <div class="work-list">
      {cases.map((work) => (
        <article class="work-row" data-work={work.slug}>
          <WorkVisual kind={work.slug} />
          <div class="work-copy">
            <div class="work-topline">
              <span class="mono">
                {work.number} / {work.title}
              </span>
              <span class="work-status">
                {work.slug === 'openclaw'
                  ? 'Merged contribution'
                  : work.slug === 'simplify'
                    ? 'Company products'
                    : work.slug === 'movie-intelligence'
                      ? 'Public technical demo'
                      : 'Ongoing research'}
              </span>
            </div>
            <h3>
              <a href={localUrl(`${work.category}/${work.slug}/`)}>
                {work.subtitle}
              </a>
            </h3>
            <p class="work-role">{work.role}</p>
            <p>{work.summary}</p>
            <ul class="tags" aria-label="Topics">
              {work.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a
              class="text-link"
              href={localUrl(`${work.category}/${work.slug}/`)}
            >
              {work.category === 'research'
                ? 'Explore the research'
                : 'Read the case study'}
              <Arrow />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="applied-section" aria-labelledby="applied-title">
    <div class="wrap section">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">02 / Applied projects & experience</p>
          <h2 id="applied-title">More ways to make AI useful.</h2>
        </div>
      </div>
      <div class="applied-grid">
        {applied.map((project) => (
          <article>
            <p class="eyebrow">{project.field}</p>
            <h3>{project.name}</h3>
            <p class="applied-role">{project.role}</p>
            <p class="mono small muted">{project.period}</p>
            <p>{project.text}</p>
            <div class="applied-end">
              {'url' in project ? (
                <>
                  <a class="text-link" href={project.url}>
                    Explore prototype <Arrow diagonal />
                  </a>
                  <a class="small muted" href={project.source}>
                    Source ↗
                  </a>
                </>
              ) : (
                <span class="mono small muted">{project.note}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    id="research"
    class="research-section section wrap"
    aria-labelledby="research-title"
  >
    <div>
      <p class="eyebrow">03 / Research in progress</p>
      <h2 id="research-title">
        A better memory starts
        <br />
        with better questions.
      </h2>
      <p class="research-question">
        How should a personal AI retrieve and inspect long-term multimodal
        history to make better predictions about what someone will do next?
      </p>
      <p class="muted">
        I’m building reproducible evaluation infrastructure to investigate that
        question. The engineering is implemented; long-term comparative
        evaluation is ongoing.
      </p>
      <a class="text-link" href={localUrl('research/personal-ai-memory/')}>
        Read the research direction <Arrow />
      </a>
    </div>
    <div class="research-concept">
      <div class="eyebrow">Two separate problems</div>
      <div>
        <span class="mono">01 / RETRIEVAL</span>
        <h3>Find the relevant episode.</h3>
        <p>
          Which moment in a large personal history actually matters to this
          prediction?
        </p>
      </div>
      <div>
        <span class="mono">02 / EVIDENCE INSPECTION</span>
        <h3>Return to the source.</h3>
        <p>
          What can the original text and visual evidence reveal beyond a
          compressed account?
        </p>
      </div>
      <p class="mono small">RESEARCH DESIGN · NOT A PERFORMANCE CLAIM</p>
    </div>
  </section>

  <section
    id="about"
    class="about-section section wrap"
    aria-labelledby="about-title"
  >
    <div class="about-intro">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Jimmy Chen standing outdoors in front of a stone archway and palm trees"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 100vw, 320px"
          width={640}
          height={720}
          format="webp"
          loading="lazy"
          class="portrait"
        />
        <span class="portrait-caption mono">JIMMY CHEN / CHEN YIWEI</span>
      </div>
      <div>
        <p class="eyebrow">04 / A little background</p>
        <h2 id="about-title">
          An engineer’s care.
          <br />A founder’s perspective.
        </h2>
        <p>
          I’m Jimmy. I work across the parts of AI that need to fit together:
          the runtime, the evidence behind an answer, the product people
          interact with, and the systems that help a team ship.
        </p>
        <p>
          At Simplify, I lead product direction, technical decisions, and
          execution with the team. Alongside that work, I contribute to open
          source and investigate retrieval and multimodal memory for personal
          AI.
        </p>
        <p class="muted">
          A secondary technical interest is daily-frequency quantitative
          research with LightGBM and GRU, through internal, owner-reported work.
        </p>
      </div>
    </div>
    <div class="background-grid">
      <div>
        <h3 class="eyebrow">Education</h3>
        <div class="education-item">
          <h4>Hong Kong Baptist University</h4>
          <p>
            BSc (Hons.) Computer Science
            <br />
            AI concentration · Finance minor
          </p>
          <span class="mono small muted">Sep 2022 – expected June 2027</span>
        </div>
        <div class="education-item">
          <h4>Hong Kong University of Science and Technology</h4>
          <p>
            HKUST · Master’s programme in AI — withdrew to pursue
            entrepreneurship. Degree not completed.
          </p>
        </div>
      </div>
      <div>
        <h3 class="eyebrow">Selected experience</h3>
        <ul class="experience-list">
          {experience.map((item) => (
            <li>
              <div>
                <strong>{item.company}</strong>
                <span class="mono small muted">{item.period}</span>
              </div>
              <p>{item.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="recognition">
      <h3 class="eyebrow">Selected recognition</h3>
      <ul>
        {recognition.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="eyebrow">05 / Contact</p>
      <div class="contact-heading">
        <h2 id="contact-title">
          Good systems start
          <br />
          with a conversation<span>↗</span>
        </h2>
        <p>
          Building something ambitious?
          <br />
          Working on agents or personal AI?
          <br />
          I’d like to hear what you’re thinking.
        </p>
      </div>
      <div class="contact-actions">
        <a class="email-link" href={`mailto:${identity.email}`}>
          {identity.email}
          <Arrow diagonal />
        </a>
        <a class="contact-github" href={identity.github}>
          Find me on GitHub <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
</Base>
