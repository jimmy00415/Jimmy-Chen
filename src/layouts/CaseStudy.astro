---
import Base from './Base.astro';
import Arrow from '../components/Arrow.astro';
import WorkVisual from '../components/WorkVisual.astro';
import ProtocolDemo from '../components/ProtocolDemo.astro';
import { cases, type CaseStudy } from '../data/cases';
import { localUrl } from '../lib/urls';
interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const next = cases[(cases.indexOf(study) + 1) % cases.length];
---

<Base title={`${study.title} — Jimmy Chen`} description={study.summary}>
  <article class="case-page wrap">
    <header class="case-header">
      <a class="back-link mono small" href={localUrl('#work')}>
        ← Selected work
      </a>
      <p class="eyebrow">
        {study.number} /{' '}
        {study.category === 'research'
          ? 'Research in progress'
          : 'Engineering & product'}
      </p>
      <h1>{study.title}</h1>
      <p class="case-subtitle">{study.subtitle}</p>
      <dl class="case-facts">
        <div>
          <dt>My role</dt>
          <dd>{study.role}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{study.status}</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>{study.period}</dd>
        </div>
      </dl>
    </header>
    <div class="case-body">
      <aside class="case-toc">
        <nav aria-label="On this page">
          <p class="eyebrow">In this case</p>
          {study.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
          <a href="#sources">
            {study.sources.length
              ? 'Inspect the sources'
              : 'Research provenance'}
          </a>
        </nav>
        <ul class="tags">
          {study.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </aside>
      <div class="case-content">
        <WorkVisual kind={study.slug} />
        <p class="case-lede">{study.summary}</p>
        {study.sections.map((section, index) => (
          <section id={section.id} class="case-section">
            <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            {study.slug === 'openclaw' && section.id === 'contribution' && (
              <ProtocolDemo />
            )}
          </section>
        ))}
        <section id="sources" class="case-sources">
          <p class="eyebrow">Inspect the work</p>
          <h2>
            {study.sources.length
              ? 'Evidence & further reading'
              : 'Research provenance'}
          </h2>
          {study.sources.length ? (
            <ul>
              {study.sources.map((source) => (
                <li>
                  <a class="text-link" href={source.url}>
                    {source.label}
                    <Arrow diagonal />
                  </a>
                  <p>{source.note}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p>
              The engineering milestone is drawn from my project records dated 6
              October 2026 and reflected in my updated CV. NextAct, NextMe-800,
              and EgoLife are external resources credited in the evaluation.
              This work has no established public code release or publication.
            </p>
          )}
        </section>
      </div>
    </div>
    <a class="next-case" href={localUrl(`${next.category}/${next.slug}/`)}>
      <div>
        <span class="eyebrow">Next case / {next.number}</span>
        <h2>{next.title}</h2>
      </div>
      <Arrow />
    </a>
  </article>
</Base>
