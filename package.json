{
  "name": "jimmy-chen-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint scripts tests && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/site.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "verify": "npm run check && npm run lint && npm run build && npm test",
    "deploy": "npm run verify && gh-pages --dist dist --dotfiles --nojekyll"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.13.0",
    "gh-pages": "6.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.0"
  }
}
